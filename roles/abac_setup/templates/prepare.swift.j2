import Vapor
import ABACAuthorization
import FluentSQL

struct Prepare: LifecycleHandler {
    
    func didBootAsync(_ app: Application) async throws {
        
        // MARK: ABACAuthorization
        
        if let sql = app.db as? (any SQLDatabase) {
            let query = SQLQueryString("SELECT EXISTS (SELECT FROM pg_tables where tablename  = '" + ABACAuthorizationPolicyModel.schema + "');")
            let abacPolicySchema = try await sql.raw(query).first(decoding: [String:Bool].self)
            if abacPolicySchema?.first?.value == true {
                let policies = try await app.abacAuthorizationRepo.getAllWithConditions()
                for policy in policies {
                    try await app.abacAuthorizationPolicyService.addToInMemoryCollection(policy: policy, conditions: policy.conditions)
                }
            }
        }
    }
}